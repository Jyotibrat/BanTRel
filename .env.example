# BanTRel environment variables
# Copy this file to .env and fill in your values.
# Never commit your actual .env file — it is in .gitignore.

# ── HuggingFace ───────────────────────────────────────────────────────────────
# Required only if the model repo (BJyotibrat/BanTRel-v1.0.0) is private.
# Leave blank or omit entirely if the repo is public.
HF_TOKEN=

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# Examples:
#   BANTREL_CORS_ORIGINS=http://localhost:3000
#   BANTREL_CORS_ORIGINS=http://localhost:3000,https://yourdomain.com
# Use * to allow all origins (fine for local dev, not recommended for prod).
BANTREL_CORS_ORIGINS=*

# ── Port ──────────────────────────────────────────────────────────────────────
# Host port to bind the API to (container always uses 7860 internally).
HOST_PORT=7860

# ── Checkpoint override ───────────────────────────────────────────────────────
# Absolute path inside the container. Leave blank to use the default location.
BANTREL_CHECKPOINT=
